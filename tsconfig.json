{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Environment Settings */
    "module": "commonjs",
    "target": "es2020",
    "lib": ["esnext"],
    "types": ["node"],
    "moduleResolution": "node",

    /* Other Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,

    /* Code Quality & Safety */
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    /* Silence TS Deprecation Warnings */
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "files": true
  }
}